# This file contains paths and a loopback listener only. It must never contain
# the installation code, its SHA-256, database credentials, or administrator
# credentials. The installer writes the active file as root:root mode 0600.
PROBE_SETUP_LISTEN_ADDR=127.0.0.1:18080
PROBE_SETUP_STATE_FILE=/var/lib/probe-panel/setup/state.json
PROBE_SETUP_CODE_FILE=/var/lib/probe-panel/setup/setup-code.json
PROBE_SETUP_ADMIN_ROOT=/srv/probe/setup-ui
PROBE_SETUP_FINALIZE_REQUEST_FILE=/run/probe-panel-setup/finalize.json
PROBE_SETUP_FINALIZE_RESULT_FILE=/run/probe-panel-setup/result.json
PROBE_SETUP_BUNDLE_ROOT=/srv/probe/releases/probe-panel-v1.0.0-linux-amd64
PROBE_SETUP_RELEASE_ID=v1.0.0
