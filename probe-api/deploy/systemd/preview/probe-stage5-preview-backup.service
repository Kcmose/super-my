[Unit]
Description=Probe Panel isolated preview PostgreSQL verified backup
After=probe-stage5-preview-postgresql.service
Requires=probe-stage5-preview-postgresql.service
RequiresMountsFor=/var/backups/probe-panel/postgres

[Service]
Type=oneshot
User=probe-api
Group=probe-api
Environment=PROBE_POSTGRES_BACKUP_DIR=/var/backups/probe-panel/postgres
Environment=PROBE_POSTGRES_DAILY_KEEP=7
Environment=PROBE_POSTGRES_WEEKLY_KEEP=4
Environment=PROBE_POSTGRES_WEEKLY_DAY=7
Environment=PGHOST=/srv/probe-stage5-preview/pgsocket
Environment=PGPORT=55433
Environment=PGDATABASE=probe_stage5_preview
Environment=PGUSER=postgres
ExecStart=/srv/probe/api/scripts/backup-postgres.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadOnlyPaths=/srv/probe-stage5-preview/config
ReadWritePaths=/var/backups/probe-panel/postgres
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
