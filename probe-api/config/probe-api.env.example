PROBE_API_LISTEN_ADDR=127.0.0.1:8080
PROBE_DATABASE_URL=postgresql://probe:change-me@127.0.0.1:5432/probe?sslmode=disable
PROBE_LOG_LEVEL=info
PROBE_API_READ_HEADER_TIMEOUT=5s
PROBE_API_READ_TIMEOUT=15s
PROBE_API_WRITE_TIMEOUT=15s
PROBE_API_IDLE_TIMEOUT=60s
PROBE_API_SHUTDOWN_TIMEOUT=15s
PROBE_DATABASE_PING_TIMEOUT=5s
PROBE_DATABASE_MAX_CONNS=20
PROBE_DATABASE_MIN_CONNS=2
PROBE_ADMIN_ORIGIN=https://admin.example.com
PROBE_AGENT_PUBLIC_URL=https://api.example.com
PROBE_AGENT_INSTALLER_URL=https://raw.githubusercontent.com/Kcmose/my-agent/refs/tags/v1.0.0/deploy/install.sh
# Optional public CA bundle used only when the Agent HTTPS origin uses a private CA.
# PROBE_AGENT_INSTALL_CA_FILE=/etc/probe-panel/tls/agent/ca.pem
PROBE_ADMIN_ALLOWLIST_FILE=/etc/probe-panel/admin-allowlist.geo
PROBE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
PROBE_SESSION_TTL=12h
PROBE_SESSION_MAX_PER_USER=5
PROBE_SESSION_REVOKED_RETENTION=24h
PROBE_LOGIN_IP_LIMIT=10
PROBE_LOGIN_IP_WINDOW=1m
PROBE_LOGIN_USERNAME_LIMIT=5
PROBE_LOGIN_USERNAME_WINDOW=5m
PROBE_AGENT_ENROLL_IP_LIMIT=20
PROBE_AGENT_RUNTIME_IP_LIMIT=600
PROBE_AGENT_NODE_LIMIT=120
PROBE_AGENT_RATE_WINDOW=1m
PROBE_RATE_LIMIT_MAX_KEYS_PER_BUCKET=10000
PROBE_NODE_OFFLINE_AFTER=45s
