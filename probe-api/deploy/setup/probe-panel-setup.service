[Unit]
Description=Probe Panel first-run setup (loopback only)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/probe-panel/setup/state.json
ConditionPathExists=/var/lib/probe-panel/setup/setup-code.json
ConditionPathExists=/srv/probe/setup-ui/index.html

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/probe-panel/setup.env
ExecStart=/usr/local/lib/probe-panel/probe-setup serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077
RuntimeDirectory=probe-panel-setup
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/probe/setup-ui
ReadWritePaths=/var/lib/probe-panel/setup
ReadWritePaths=/run/probe-panel-setup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SocketBindAllow=tcp:18080
SocketBindDeny=any

[Install]
WantedBy=multi-user.target
