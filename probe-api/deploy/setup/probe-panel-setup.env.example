# This file contains only fixed setup paths and release identity. It must never
# contain session/CSRF tokens, database credentials, or administrator
# credentials. The installer writes the active file as root:root mode 0600.
PROBE_SETUP_STATE_FILE=/var/lib/probe-panel/setup/state.json
PROBE_SETUP_ADMIN_ROOT=/srv/probe/setup-ui
PROBE_SETUP_SOCKET_PATH=/run/probe-panel-setup/setup.sock
PROBE_SETUP_PROFILE=management
PROBE_SETUP_PLATFORM_ID=debian-13-systemd
PROBE_SETUP_SERVER_IP=192.0.2.10
PROBE_SETUP_FINALIZE_REQUEST_FILE=/run/probe-panel-setup/finalize.json
PROBE_SETUP_FINALIZE_RESULT_FILE=/run/probe-panel-setup/result.json
PROBE_SETUP_BUNDLE_ROOT=/srv/probe/releases/probe-panel-management-v1.2.0-linux-amd64
PROBE_SETUP_RELEASE_ID=v1.2.0
